name: Build iOS (IPA sin firmar)

on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  build:
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4

      - name: Instalar XcodeGen
        run: brew install xcodegen

      - name: Generar proyecto Xcode
        run: xcodegen generate

      - name: Compilar (sin firma)
        run: |
          xcodebuild -project HealthPPiOS.xcodeproj \
            -scheme HealthPPiOS \
            -configuration Release \
            -sdk iphoneos \
            -derivedDataPath build \
            CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY="" \
            build

      - name: Empaquetar IPA
        run: |
          mkdir -p Payload
          cp -R build/Build/Products/Release-iphoneos/HealthPPiOS.app Payload/
          zip -qr HealthPPiOS-unsigned.ipa Payload

      - uses: actions/upload-artifact@v4
        with:
          name: HealthPPiOS-unsigned-ipa
          path: HealthPPiOS-unsigned.ipa
